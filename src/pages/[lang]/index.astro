---
import { languagesList } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import History from '../../components/History.astro';
import Legacy from '../../components/Legacy.astro';
import Guide from '../../components/Guide.astro';
import Sources from '../../components/Sources.astro';
import Food from '../../components/Food.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import Weather from '../../components/Weather.astro';
import Seasons from '../../components/Seasons.astro';
import Audiences from '../../components/Audiences.astro';
import Routes from '../../components/Routes.astro';
import Facilities from '../../components/Facilities.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import Responsibility from '../../components/Responsibility.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
import KathaCTA from '../../components/KathaCTA.astro';
import HistoryCTA from '../../components/HistoryCTA.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import { getI18n } from '../../i18n/ui';
import { nearby } from '../../data/nearby';

export async function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = await getI18n(Astro.url);
---

<BaseLayout lang={lang} title={messages.meta.title} description={messages.meta.description} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} />
    <About messages={messages} />
    <KathaCTA lang={lang} messages={messages} />
    <History messages={messages} />
    <HistoryCTA lang={lang} messages={messages} />
    <Legacy messages={messages} />
    <Ecosystem messages={messages} />
    <Guide messages={messages} />
    <section class="bg-ivory text-ink py-16" id="explore">
      <div class="max-w-6xl mx-auto px-5">
        <h2 class="font-display text-teak text-3xl">{{ en: 'Explore nearby attractions', th: 'เที่ยวชมสถานที่ใกล้เคียง', zh: '探索周边景点' }[lang]}</h2>
        <p class="mt-3 text-ink/70">{{ en: 'Explore 17 individual guides to temples, nature, pilgrimage routes, campus districts and transport.', th: 'อ่านคู่มือ 17 เรื่อง ครอบคลุมวัด ธรรมชาติ เส้นทางศรัทธา ย่านมหาวิทยาลัยและการเดินทาง', zh: '通过 17 篇独立指南探索寺庙、自然、朝圣路线、校园街区与交通。' }[lang]}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
          {nearby.map(place => <a href={`/${lang}/explore/${place.slug}/`} class="rounded-2xl bg-white/75 border border-gold/25 p-5 hover:border-gold transition-colors"><h3 class="font-display text-teak text-xl">{place.content[lang].name}</h3><p class="mt-3 text-sm text-ink/70">{place.content[lang].intro}</p><span class="block mt-4 text-gold">→</span></a>)}
        </div>
        <a href={`/${lang}/explore/`} class="inline-block mt-6 text-gold font-semibold underline">{{ en: 'All nearby guides', th: 'ดูคู่มือทั้งหมด', zh: '查看全部周边指南' }[lang]}</a>
      </div>
    </section>
    <Food messages={messages} />
    <Weather lang={lang} messages={messages} />
    <Seasons messages={messages} />
    <Audiences lang={lang} messages={messages} />
    <Routes messages={messages} />
    <Facilities messages={messages} />
    <Gallery lang={lang} messages={messages} />
    <Reviews messages={messages} />
    <Responsibility messages={messages} />
    <Sources lang={lang} messages={messages} />
    <MapSection lang={lang} messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
  <MobileCTA lang={lang} messages={messages} />
</BaseLayout>
