---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const a = messages.audiences;
---

<section id="audiences" class="py-20 bg-sand text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{a.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{a.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{a.intro}</p>

    <div class="mt-10 grid lg:grid-cols-3 gap-6">
      {
        a.routes.map((r: any) => (
          <div class="rounded-2xl border border-gold/25 bg-white p-6 flex flex-col shadow-sm">
            <span class="text-xs text-teak bg-gold/15 border border-gold/30 rounded-full px-3 py-1 self-start">
              {r.tag}
            </span>
            <h3 class="font-display text-2xl text-teak mt-4">{r.name}</h3>
            <p class="mt-1 text-sm text-gold font-semibold">{r.duration}</p>
            <p class="mt-3 text-sm text-ink/75 leading-relaxed">{r.suitable}</p>

            <ol class="mt-5 space-y-3 flex-1">
              {r.steps.map((step: string, i: number) => (
                <li class="flex gap-3">
                  <span class="font-display text-gold mt-0.5">{i + 1}.</span>
                  <span class="text-sm text-ink/80 leading-relaxed">{step}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: a.heading,
  itemListElement: a.routes.map((r: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${r.name} — ${siteConfig.name[lang]}`,
    description: r.suitable,
  })),
})} />
