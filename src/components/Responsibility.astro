---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const r = messages.responsibility;
---

<section id="responsibility" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{r.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{r.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/80">{r.intro}</p>

    <h3 class="font-display text-2xl text-goldBright mt-10">{r.scienceTitle}</h3>
    <div class="mt-5 grid md:grid-cols-3 gap-4">
      {
        r.science.map((item: any, i: number) => (
          <div class="rounded-2xl border border-gold/25 bg-teak/60 p-5">
            <p class="font-display text-gold text-lg">0{i + 1}</p>
            <h4 class="font-display text-lg text-ivory mt-1">{item.title}</h4>
            <p class="mt-2 text-sm text-ivory/80 leading-relaxed">{item.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-gold/25 bg-teak/50 p-6">
        <h3 class="font-display text-xl text-goldBright">{r.doTitle}</h3>
        <ul class="mt-4 space-y-3">
          {
            r.do.map((item: string) => (
              <li class="flex gap-3 text-sm text-ivory/85 leading-relaxed">
                <span aria-hidden="true" class="text-gold">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-gold/25 bg-teak/50 p-6">
        <h3 class="font-display text-xl text-goldBright">{r.dontTitle}</h3>
        <ul class="mt-4 space-y-3">
          {
            r.dont.map((item: string) => (
              <li class="flex gap-3 text-sm text-ivory/85 leading-relaxed">
                <span aria-hidden="true" class="text-gold/80">✕</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-10 text-sm text-ivory/70 border-l-4 border-gold pl-4 leading-relaxed">
      {r.conservation}
    </p>
  </div>
</section>
