---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="py-20 bg-sand text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{f.intro}</p>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        f.items.map((item: any) => (
          <div class="rounded-2xl border border-gold/25 bg-sand p-5 flex flex-col">
            <h3 class="font-display text-lg text-teak">{item.type}</h3>
            <p class="mt-2 text-sm text-ink/80 leading-relaxed flex-1">{item.desc}</p>
            {item.hint && (
              <p class="mt-3 text-xs text-teak bg-gold/15 border border-gold/30 rounded-full px-3 py-1 inline-block self-start">
                {item.hint}
              </p>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-ink/60 border-l-4 border-gold pl-4">{f.note}</p>
  </div>
</section>
