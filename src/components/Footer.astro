---
import { siteConfig } from '../config';

interface Props {
  lang: 'th' | 'en' | 'zh';
  messages: Record<string, any>;
}
const { lang } = Astro.props;
const copy = {
  zh: {
    rights: '版權所有',
    independence: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联',
    accuracy: '信息可能随时变更，请在出行前确认。',
  },
  en: {
    rights: 'All rights reserved',
    independence: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
    accuracy: 'Information may change at any time. Please check before traveling.',
  },
  th: {
    rights: 'สงวนลิขสิทธิ์',
    independence: 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ',
    accuracy: 'ข้อมูลอาจเปลี่ยนแปลงได้ โปรดตรวจสอบก่อนเดินทาง',
  },
}[lang];
---

<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 text-xs md:text-sm text-ivory/75 leading-relaxed space-y-2">
    <p>© 2026 {siteConfig.name[lang]} · {copy.rights}</p>
    <p>{copy.independence}</p>
    <p>{copy.accuracy}</p>
  </div>
</footer>
