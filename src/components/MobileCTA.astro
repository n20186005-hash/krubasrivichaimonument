---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const cta = messages.mobileCta ?? { map: 'Map', guide: 'Guide' };
---

{/* Spacer keeps the footer clear of the fixed bar on small screens. */}
<div class="h-20 md:hidden" aria-hidden="true"></div>

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-gold/30 bg-teakDeep/95 px-4 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden"
>
  <div class="flex gap-2.5">
    <a
      href={siteConfig.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-1 items-center justify-center gap-2 rounded-full bg-gold px-4 py-3 text-sm font-semibold text-teakDeep shadow-lg"
    >
      <span aria-hidden="true">🗺</span>{cta.map}
    </a>
    <a
      href="#guide"
      class="flex flex-1 items-center justify-center gap-2 rounded-full border border-gold/60 px-4 py-3 text-sm font-semibold text-gold"
    >
      <span aria-hidden="true">📖</span>{cta.guide}
    </a>
  </div>
</div>
